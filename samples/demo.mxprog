// Sample program for the Extension Development Host (F5).
// Whole-line comments like this one are what RoboDK writes into a .mxprog.

/*
  Block comments span lines. Anything in here is ignored, including calls
  that would otherwise be flagged:
      MoveLin(1)
*/

// --- valid: nothing below should be flagged ---
SetJointVel(25)
SetBlending(50)
MoveJoints(4.300000, 28.670000, 61.680000, 2.050000, -101.740000, 0.450000)
MoveLin(180, 0, 120, 0, 90, 0)
MoveLinRelTrf(0,0,-50,0,0,0)
SetCheckpoint(1)
Delay(0.5)
StartProgram("LOAD_NEST")
ActivateRobot()
ActivateRobot(1)
SetRealTimeMonitoring(2200, 2201)
SetRealTimeMonitoring(TargetCartPos, TargetJointPos)
SetRobotName("my-robot")
LogTrace("a // that is not a comment, and a comma")
-MoveLin(208, 50, 40, 0, 0, 90)
GripperOpen() /* a trailing block comment */
GripperClose() /* block */ // and line

// --- variables (beta): all of this is valid ---
CreateVariable(myGroup.myJointPos, [0, 0, 0, 0, 0, 0], 10000, 0, 0)
CreateVariable(myGroup.myDelay, 0.5)
CreateVariable(myGroup.myName, "station-A")
CreateVariable(myGroup.isReady, true)
SetVariable(myGroup.myDelay, 1.25)
MoveJoints(*vars.myGroup.myJointPos)
SetPayload(vars.myGroup.m, vars.myGroup.cx, vars.myGroup.cy, vars.myGroup.cz)
Delay(vars.myGroup.myDelay)
GetVariable(myGroup.myName)

SetWRF(0, 0, 0, 0, 0, 0)
setwrf(0, 0, 0, 0, 0, 0)

// The two lines above are deliberate: the robot resolves instruction names in
// any case, so SetWRF and setwrf both reach SetWrf and neither is a problem.

// --- each line below should be flagged, one problem per line ---
MoveLinear(180, 0, 120, 0, 90, 0)
MoveLin(180, 0, 120)
MoveLin(180, 0, 120, 0, 90, abc)
Delay(1e3)
SetCheckpoint(2.5)
SetConf(0, 1, 1)
SetBlending(150)
ActivateRobot(1, 2)
SetRealTimeMonitoring(2200, TargetCartPos)
SetRobotName(my-robot)
MoveLin([1, 2], 0, 0, 0, 0, 0)
SetVariable(myVar, a-b)
LogTrace("never closed
MoveLin 180, 0, 120, 0, 90, 0

// Left open on purpose: everything below is swallowed, and the extension says so.
