{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mecademic program",
  "scopeName": "source.mxprog",
  "fileTypes": [
    "mxprog"
  ],
  "firmware": "11.3",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#instruction"
    },
    {
      "include": "#number"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.mxprog",
      "match": "//.*$"
    },
    "instruction": {
      "name": "support.function.instruction.mxprog",
      "match": "\\b(?:GetCheckpointDiscarded|GetMonitoringInterval|GetRealTimeMonitoring|GetTorqueLimitsStatus|SetCtrlPortMonitoring|SetMonitoringInterval|SetOfflineProgramLoop|SetRealTimeMonitoring|GetEthernetIpEnabled|GetRtTargetJointTorq|GetExtToolFwVersion|GetModelJointLimits|GetRtTargetConfTurn|GetRtTargetJointPos|GetRtTargetJointVel|GetSafetyStopStatus|ConnectionWatchdog|GetCmdPendingCount|GetCollisionStatus|GetMoveDurationCfg|GetProfinetEnabled|GetRobotCalibrated|GetRtAccelerometer|GetRtExtToolStatus|GetRtTargetCartPos|GetRtTargetCartVel|GetTorqueLimitsCfg|SetMoveDurationCfg|SetTorqueLimitsCfg|GetCalibrationCfg|GetJointLimitsCfg|GetNetworkOptions|GetRtGripperForce|GetRtGripperState|GetWorkZoneLimits|GetWorkZoneStatus|SetCalibrationCfg|SetJointLimitsCfg|SetNetworkOptions|SetWorkZoneLimits|EnableEtherNetIp|GetJointVelLimit|SetJointVelLimit|SwitchToEtherCat|DeactivateRobot|GetAutoConfTurn|GetCollisionCfg|GetGripperForce|GetGripperRange|GetMoveDuration|GetRecoveryMode|GetRtGripperPos|GetRtTargetConf|GetRtValveState|GetTorqueLimits|LogUserCommands|SetAutoConfTurn|SetCollisionCfg|SetGripperForce|SetGripperRange|SetMoveDuration|SetRecoveryMode|SetTorqueLimits|CreateVariable|DeleteVariable|EnableProfinet|GetJointLimits|GetProductType|GetRobotSerial|GetRtJointTorq|GetStatusRobot|GetTimeScaling|GetWorkZoneCfg|SetJointLimits|SetTimeScaling|SetWorkZoneCfg|ActivateRobot|DeactivateSim|GetCartAngVel|GetCartLinVel|GetCheckpoint|GetExtToolSim|GetGripperVel|GetRtConfTurn|GetRtJointPos|GetRtJointVel|GetSimModeCfg|GetToolSphere|GetVelTimeout|ListVariables|MoveJointsRel|MoveJointsVel|MoveLinRelTrf|MoveLinRelWrf|MoveLinVelTrf|MoveLinVelWrf|SetCartAngVel|SetCartLinVel|SetCheckpoint|SetExtToolSim|SetGripperVel|SetSimModeCfg|SetToolSphere|SetValveState|SetVelTimeout|GetFwVersion|GetPStop2Cfg|GetRobotName|GetRtCartPos|GetRtCartVel|GripperClose|ResumeMotion|SetPStop2Cfg|SetRobotName|StartProgram|SyncCmdQueue|ActivateSim|ClearMotion|GetAutoConf|GetBlending|GetConfTurn|GetJointAcc|GetJointVel|GetMoveMode|GetVariable|GripperOpen|MoveGripper|PauseMotion|RebootRobot|SetAutoConf|SetBlending|SetConfTurn|SetJointAcc|SetJointVel|SetMoveMode|SetVariable|StartSaving|TcpDumpStop|GetCartAcc|GetPayload|MoveJoints|ResetError|SetCartAcc|SetPayload|StopSaving|GetRtConf|GetRtTrf|GetRtWrf|LogTrace|MovePose|GetConf|MoveLin|SetConf|TcpDump|GetRtc|GetTrf|GetWrf|SetEob|SetEom|SetRtc|SetTrf|SetWrf|Delay|Home)\\b(?=\\s*\\()"
    },
    "number": {
      "name": "constant.numeric.mxprog",
      "match": "[-+]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.mxprog",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.comma.mxprog",
          "match": ","
        }
      ]
    }
  }
}
