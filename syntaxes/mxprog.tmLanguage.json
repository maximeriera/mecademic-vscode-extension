{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mecademic program",
  "scopeName": "source.mxprog",
  "fileTypes": [
    "mxprog"
  ],
  "firmware": "11.3",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#silent"
    },
    {
      "include": "#instruction"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#name"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mxprog",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mxprog",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "silent": {
      "name": "keyword.operator.silent.mxprog",
      "match": "^\\s*-(?=\\s*[A-Za-z_])"
    },
    "instruction": {
      "name": "support.function.instruction.mxprog",
      "match": "\\b(?i:GetCheckpointDiscarded|GetMonitoringInterval|GetRealTimeMonitoring|GetTorqueLimitsStatus|SetCtrlPortMonitoring|SetMonitoringInterval|SetOfflineProgramLoop|SetRealTimeMonitoring|GetEthernetIpEnabled|GetRtTargetJointTorq|GetExtToolFwVersion|GetModelJointLimits|GetRtTargetConfTurn|GetRtTargetJointPos|GetRtTargetJointVel|GetSafetyStopStatus|ConnectionWatchdog|GetCmdPendingCount|GetCollisionStatus|GetMoveDurationCfg|GetProfinetEnabled|GetRobotCalibrated|GetRtAccelerometer|GetRtExtToolStatus|GetRtTargetCartPos|GetRtTargetCartVel|GetTorqueLimitsCfg|SetMoveDurationCfg|SetTorqueLimitsCfg|GetCalibrationCfg|GetJointLimitsCfg|GetNetworkOptions|GetRtGripperForce|GetRtGripperState|GetWorkZoneLimits|GetWorkZoneStatus|SetCalibrationCfg|SetJointLimitsCfg|SetNetworkOptions|SetWorkZoneLimits|EnableEtherNetIp|GetJointVelLimit|SetJointVelLimit|SwitchToEtherCat|DeactivateRobot|GetAutoConfTurn|GetCollisionCfg|GetGripperForce|GetGripperRange|GetMoveDuration|GetRecoveryMode|GetRtGripperPos|GetRtTargetConf|GetRtValveState|GetTorqueLimits|LogUserCommands|SetAutoConfTurn|SetCollisionCfg|SetGripperForce|SetGripperRange|SetMoveDuration|SetRecoveryMode|SetTorqueLimits|CreateVariable|DeleteVariable|EnableProfinet|GetJointLimits|GetProductType|GetRobotSerial|GetRtJointTorq|GetStatusRobot|GetTimeScaling|GetWorkZoneCfg|SetJointLimits|SetTimeScaling|SetWorkZoneCfg|ActivateRobot|DeactivateSim|GetCartAngVel|GetCartLinVel|GetCheckpoint|GetExtToolSim|GetGripperVel|GetRtConfTurn|GetRtJointPos|GetRtJointVel|GetSimModeCfg|GetToolSphere|GetVelTimeout|ListVariables|MoveJointsRel|MoveJointsVel|MoveLinRelTrf|MoveLinRelWrf|MoveLinVelTrf|MoveLinVelWrf|SetCartAngVel|SetCartLinVel|SetCheckpoint|SetExtToolSim|SetGripperVel|SetSimModeCfg|SetToolSphere|SetValveState|SetVelTimeout|GetFwVersion|GetPStop2Cfg|GetRobotName|GetRtCartPos|GetRtCartVel|GripperClose|ResumeMotion|SetPStop2Cfg|SetRobotName|StartProgram|SyncCmdQueue|ActivateSim|ClearMotion|GetAutoConf|GetBlending|GetConfTurn|GetJointAcc|GetJointVel|GetMoveMode|GetVariable|GripperOpen|MoveGripper|PauseMotion|RebootRobot|SetAutoConf|SetBlending|SetConfTurn|SetJointAcc|SetJointVel|SetMoveMode|SetVariable|StartSaving|TcpDumpStop|GetCartAcc|GetPayload|MoveJoints|ResetError|SetCartAcc|SetPayload|StopSaving|GetRtConf|GetRtTrf|GetRtWrf|LogTrace|MovePose|GetConf|MoveLin|SetConf|TcpDump|GetRtc|GetTrf|GetWrf|SetEob|SetEom|SetRtc|SetTrf|SetWrf|Delay|Home)\\b(?=\\s*\\()"
    },
    "variable": {
      "match": "(\\*)?\\b(vars(?:\\.[A-Za-z_][A-Za-z0-9_]*)+)\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.unroll.mxprog"
        },
        "2": {
          "name": "variable.other.mxprog"
        }
      }
    },
    "boolean": {
      "name": "constant.language.boolean.mxprog",
      "match": "\\b(?:true|false)\\b"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.mxprog",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mxprog",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.mxprog",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.mxprog",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "number": {
      "name": "constant.numeric.mxprog",
      "match": "[-+]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)"
    },
    "name": {
      "name": "support.constant.mxprog",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\b(?!\\s*\\()"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.mxprog",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.mxprog",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.mxprog",
          "match": ","
        }
      ]
    }
  }
}
